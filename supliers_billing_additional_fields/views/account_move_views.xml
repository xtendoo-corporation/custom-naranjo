<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario -->
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="x_last_payment_date" attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund'))]}"/>
            </xpath>
        </field>
    </record>

    <!-- Vista de árbol específica para facturas de proveedores -->
    <record id="view_vendor_bill_tree_inherit" model="ir.ui.view">
        <field name="name">account.move.supplier.tree.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="x_last_payment_date"/>
            </xpath>
        </field>
    </record>
</odoo>
